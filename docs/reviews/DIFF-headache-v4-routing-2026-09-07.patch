+      ['q-onset', 'recurrent'], ['q-frequency', 'f-ge15'], ['q-duration', 'd-15-180'],
+      ['q-attack-count', 'c-gt10'], ['q-chronicity', 'ch-ge3'], ['q-quality', 'qual-sharp'],
